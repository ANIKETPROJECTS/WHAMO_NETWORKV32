{
  "name": "whamo-local-designer",
  "version": "1.0.0",
  "description": "Offline desktop wrapper for the WHAMO network designer",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.cjs",
    "start": "npm --prefix .. run build && npm run prepare:assets && electron .",
    "package:win": "npm --prefix .. run build && npm run prepare:assets && electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.22.3"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.whamo.local-designer",
    "productName": "WHAMO Network Designer Local",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "desktop-server.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app-assets",
        "to": "app-assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "engine/WHAMO.EXE",
        "to": "WHAMO.EXE"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WHAMO-Local-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
